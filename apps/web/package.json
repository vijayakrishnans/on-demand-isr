{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "highlight.js": "11.11.1",
    "jsonwebtoken": "9.0.2",
    "marked": "15.0.7",
    "marked-highlight": "2.2.1",
    "next": "15.5.29",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sass": "1.85.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "22.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.27.0",
    "postcss": "8.5.2",
    "typescript": "5.7.3",
    "wrangler": "^4.160.1"
  }
}
